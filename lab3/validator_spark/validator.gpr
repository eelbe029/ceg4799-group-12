project Validator is
   for Source_Dirs use ("src");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("harness.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-gnata", "-gnatwa");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "-j0");
   end Prove;
end Validator;
