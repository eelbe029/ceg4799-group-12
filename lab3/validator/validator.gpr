--  CEG 4799 / CSI 4539 - Lab 3
--  GPR project for the SPARK input validator (E1).
--
--  Build : gprbuild  -P validator.gpr
--  Flow  : gnatprove -P validator.gpr --mode=flow
--  Prove : gnatprove -P validator.gpr --mode=prove --level=2
--
--  src/    SPARK code (SPARK_Mode => On)   : package Input_Validator
--  tests/  non-SPARK harness (SPARK_Mode => Off) : procedure Test_Validator

project Validator is

   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("test_validator.adb");

   package Compiler is
      --  -gnata  : contracts (Pre, Post, predicates) are checked at run time
      --  -gnatwa : all compiler warnings
      --  -gnato  : overflow checks (no check is ever suppressed)
      for Default_Switches ("Ada") use ("-gnata", "-gnatwa", "-gnato", "-g");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2");
   end Prove;

end Validator;
